{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maybe2122/Robot-Sports-Gym/schemas/shot-record.v1.json",
  "title": "Shot record (bank schema_version 1)",
  "description": "One line of a shot bank JSONL split.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "shot_id",
    "sport",
    "level",
    "position",
    "linear_velocity",
    "angular_velocity",
    "tags"
  ],
  "properties": {
    "shot_id": {
      "type": "string",
      "minLength": 1
    },
    "sport": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "pattern": "^L[0-5]$"
    },
    "position": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "linear_velocity": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "angular_velocity": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "target": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "center_xy",
            "radius_m"
          ],
          "properties": {
            "center_xy": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "radius_m": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      ]
    }
  }
}
