{
  "schema_version": 1,
  "benchmark": "multisport-shot-skill-v0",
  "task": "tennis-return-v0",
  "sport": "tennis",
  "status": "experimental",
  "leaderboard_eligible": false,
  "warning": "Statistically sufficient per level (100 test episodes) but still an experimental bank: per-bucket counts remain below 100, and no leaderboard has been opened.",
  "units": "SI",
  "coordinate_system": {
    "origin": "table_center_at_floor_projection",
    "x_axis": "robot_side_to_opponent_side",
    "y_axis": "table_lateral",
    "z_axis": "up",
    "net_plane_x_m": 0.0,
    "robot_side": "x < 0",
    "opponent_side": "x > 0",
    "table_top_z_m": 0.0,
    "table_bounds_m": {
      "x": [
        -11.885,
        11.885
      ],
      "y": [
        -4.115,
        4.115
      ]
    }
  },
  "episode": {
    "timeout_s": 3.0,
    "success_sequence": [
      "robot_racket_contact",
      "cross_net_toward_opponent",
      "first_post_hit_landing_on_opponent_table"
    ],
    "timeout_is_truncation": true
  },
  "levels": {
    "L0": {
      "name": "Physics",
      "distribution": "fixed center trajectories without robot action",
      "primary_metric": "incoming_valid_rate",
      "pass_threshold": 1.0
    },
    "L1": {
      "name": "Intercept",
      "distribution": "center, slow, no-spin or low-spin",
      "primary_metric": "hit_rate",
      "pass_threshold": 0.9
    },
    "L2": {
      "name": "Return",
      "distribution": "forehand/backhand lateral variation at normal speed",
      "primary_metric": "valid_return_rate",
      "pass_threshold": 0.8
    },
    "L3": {
      "name": "Placement",
      "distribution": "left, center, right and deep circular landing targets",
      "primary_metric": "target_rate",
      "pass_threshold": 0.7
    },
    "L4": {
      "name": "Robustness",
      "distribution": "fixed combinations of fast, spin, edge, short/deep and low shots",
      "primary_metric": "worst_bucket_valid_return_rate",
      "pass_threshold": 0.6,
      "pass_buckets": [
        "fast",
        "spin",
        "edge",
        "depth",
        "low"
      ]
    },
    "L5": {
      "name": "Generalization",
      "distribution": "fixed held-out trajectory combinations; randomization, observation noise and latency are not implemented in return-v0",
      "primary_metric": "worst_bucket_valid_return_rate",
      "pass_threshold": 0.5,
      "aggregate_metric": "valid_return_rate",
      "aggregate_threshold": 0.6,
      "pass_buckets": [
        "fast",
        "spin",
        "edge_or_depth",
        "low",
        "held-out"
      ]
    }
  },
